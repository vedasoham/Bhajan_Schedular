<header class="topbar">

    <button type="button" id="mobileSidebarToggle" class="mobile-menu-btn" aria-label="Open navigation menu">☰</button>

    <div class="page-title">
        <%= pageTitle || "Dashboard" %>
    </div>

    <div class="admin-info">

        <span class="admin-name">

            <%= currentAdmin.displayName %>

        </span>

        <span class="role-badge">

            <%= currentAdmin.role === "super_admin"
                ? "Super Admin"
                : "Admin" %>

        </span>

    </div>

</header>
