<div class="prasanthi-border"></div>
<div class="bulletin-detail-container">
  <a href="/bulletins" class="bulletin-back-link">← Back to Updates</a>

  <div class="bulletin-detail-card">
    <div class="bulletin-detail-meta">
      <% 
        const catInfo = CATEGORY_INFO[bulletin.category] || CATEGORY_INFO.announcement;
        const isNew = bulletin.published_at && (Date.now() - new Date(bulletin.published_at).getTime()) < 5 * 24 * 60 * 60 * 1000;
      %>
      <span class="bulletin-category-badge" style="background:<%= catInfo.color %>"><%= catInfo.icon %> <%= catInfo.label %></span>
      <% if (isNew) { %><span class="bulletin-new-badge">🆕 NEW</span><% } %>
      <% if (bulletin.is_pinned) { %><span class="bulletin-pin-badge">📌 Pinned</span><% } %>
    </div>

    <h1><%= bulletin.title %></h1>

    <div class="bulletin-card-date" style="margin-bottom: 20px;">
      <% if (bulletin.published_at) { %>
        Published <%= new Date(bulletin.published_at).toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %>
      <% } %>
    </div>

    <div class="bulletin-detail-content">
      <%- formatContent(bulletin.content) %>
    </div>
  </div>

  <div style="text-align: center; margin-top: 24px;">
    <a href="/" class="bulletin-back-link">🏠 Back to Home</a>
  </div>
</div>
