<div class="container container-lg">
    <div class="header" style="background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%); color: #0277bd;">
      <h1 style="color: #0277bd;">📖 Singer Dictionary</h1>
      <p>Manage the Master List of Approved Singer Names</p>
    </div>
    
    <div style="margin-bottom: 20px;">
      <a href="/admin" class="button secondary">⬅️ Back to Admin</a>
    </div>

    <div style="background:#f8f9fa; padding:20px; border-radius:12px; border:1px solid #dee2e6; margin-bottom:24px;">
      <h3 style="margin-bottom:12px; color:#495057;">➕ Add New Singer</h3>
      <form action="/api/admin/add-singer" method="POST" style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
        <input type="text" name="name" required class="filter-input" placeholder="e.g., Rahul S." style="max-width:300px;">
        <select name="gender" required class="filter-input" style="max-width:150px;">
          <option value="">Gender</option>
          <option value="Male">Male</option>
          <option value="Female">Female</option>
          <option value="Other">Other</option>
        </select>
        <button type="submit" class="button" style="background:#28a745; border:none; padding:10px 20px;">Add Singer</button>
      </form>
    </div>

    <div class="table-container">
      <table id="singerDictTable">
        <thead>
          <tr>
            <th onclick="sortTable(0, 'singerDictTable')" style="cursor:pointer;">Singer Name ↕</th>
            <th>Gender</th>
            <th style="text-align:right;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (singers.length > 0) { %>
            <% singers.forEach(s => { %>
              <tr>
                <td><strong><%= s.name %></strong></td>
                <td><%= s.gender || 'Not set' %></td>
                <td style="text-align:right;">
                  <form action="/api/admin/edit-singer/<%= s.id %>" method="POST" style="margin:0; display:inline;" id="edit-form-<%= s.id %>">
                    <input type="hidden" name="name" id="edit-input-<%= s.id %>" value="<%= s.name %>">
                    <input type="hidden" name="gender" id="edit-gender-<%= s.id %>" value="<%= s.gender || '' %>">
                    <button type="button" class="button" style="padding:6px 12px; font-size:12px; background:#4dabf7; border:none;" onclick="editSinger(<%= s.id %>, '<%= s.name.replace(/'/g, "\\'") %>')">✏️ Edit</button>
                  </form>
                  <form action="/api/admin/delete-singer/<%= s.id %>" method="POST" style="margin:0; display:inline;" onsubmit="return confirm('Delete this singer from the dictionary?');"><button type="submit" class="button" style="padding:6px 12px; font-size:12px; background:#e03131; border:none;">❌ Delete</button></form>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="3" style="text-align:center;">No singers in dictionary yet. Add one above!</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
  <script src="/js/script.js"></script>
