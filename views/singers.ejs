<div class="container container-lg">
    <div class="header">
      <h1>👤 Singer Directory</h1>
      <p>Devotee Participation Stats</p>
    </div>
    
    <div style="margin-bottom: 20px; display:flex; gap:10px; align-items:center;">
      <a href="/admin" class="button secondary">⬅️ Back to Admin</a>
      <a href="/admin/singer-dictionary" class="button" style="background:linear-gradient(135deg, #0284c7 0%, #0369a1 100%); color:#ffffff; border:none; border-radius:8px; padding:10px 18px; font-weight:600; text-decoration:none;">📖 Singer Dictionary (Add / Edit / Delete)</a>
    </div>

    <div class="table-container">
      <table id="singerTable">
        <thead>
          <tr>
            <th onclick="sortTable(0, 'singerTable')" style="cursor:pointer; background:#c3fae8; color:#087f5b;">Singer Name ↕</th>
            <th onclick="sortTable(1, 'singerTable')" style="cursor:pointer; background:#c3fae8; color:#087f5b; text-align:center;">Total Bhajans Sung ↕</th>
            <th onclick="sortTable(2, 'singerTable')" style="cursor:pointer; background:#c3fae8; color:#087f5b;">Last Sung Date ↕</th>
          </tr>
        </thead>
        <tbody>
          <% singers.forEach(s => { %>
            <tr>
              <td><strong><%= s.singer_name %></strong></td>
              <td style="text-align:center;"><span style="background:#20c997; color:white; padding:4px 10px; border-radius:20px; font-weight:bold; font-size:12px;"><%= s.total_sung %></span></td>
              <td data-sort="<%= s.last_sung %>"><%= s.formattedDate %> <br><small style="color:#868e96;"><%= s.lastSungHuman %></small></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <script src="/js/script.js"></script>
