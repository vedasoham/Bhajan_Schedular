<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Forgot Password</title>

    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel="stylesheet" href="/css/style.css">

    <style>

        .container{
            max-width:420px;
            padding:40px;
        }

        .subtitle{
            text-align:center;
            color:#666;
            margin-top:-10px;
            margin-bottom:28px;
            line-height:1.5;
        }

        .error-box{
            background:#ffe3e3;
            color:#c62828;
            padding:12px;
            border-radius:8px;
            text-align:center;
            margin-bottom:20px;
        }

        .back-link{
            text-align:center;
            margin-top:22px;
        }

        .back-link a{
            color:#868e96;
            text-decoration:none;
        }

        .back-link a:hover{
            text-decoration:underline;
        }

    </style>

</head>

<body>

<div class="container">

    <h2
        style="
        text-align:center;
        color:#C2185B;
        margin-bottom:16px;">
        🔑 Password Recovery
    </h2>

    <p class="subtitle">
        Enter your username to continue.
    </p>

    <% if(error){ %>

        <div class="error-box">
            <%= error %>
        </div>

    <% } %>

    <form method="POST" action="/forgot-password">

        <div class="form-group">

            <label>Username</label>

            <input
                type="text"
                name="username"
                required
                autofocus>

        </div>

        <button
            type="submit"
            class="submit-btn">

            Continue

        </button>

    </form>

    <div class="back-link">
        <a href="/admin-login">
            ← Back to Login
        </a>
    </div>

</div>

</body>
</html>