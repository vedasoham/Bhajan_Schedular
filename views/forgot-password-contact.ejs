<!DOCTYPE html>
<html>
<head>

    <meta charset="UTF-8">

    <title>Password Recovery</title>

    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel="stylesheet" href="/css/style.css">

    <style>

        .container{
            max-width:480px;
            padding:40px;
            text-align:center;
        }

        .card{
            background:#f8f9fa;
            border-radius:12px;
            padding:22px;
            margin:28px 0;
        }

        .contact{
            color:#C2185B;
            font-size:22px;
            font-weight:700;
            margin-top:8px;
        }

        .note{
            color:#666;
            line-height:1.6;
        }

        .back-link{
            margin-top:26px;
        }

        .back-link a{
            text-decoration:none;
            color:#868e96;
        }

        .back-link a:hover{
            text-decoration:underline;
        }

    </style>

</head>

<body>

<div class="container">

    <h2 style="color:#C2185B;">
        🔒 Password Recovery
    </h2>

    <div class="card">

        <p class="note">

            This administrator account does not have
            a Google account linked.

        </p>

        <p class="note">

            Please contact the Super Administrator
            to reset your password.

        </p>

        <div class="contact">

            <%= superAdmin.display_name %>

        </div>

    </div>

    <div class="back-link">

        <a href="/admin-login">

            ← Back to Login

        </a>

    </div>

</div>

</body>
</html>