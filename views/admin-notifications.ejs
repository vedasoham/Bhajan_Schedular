<div style="margin-bottom: 24px;">
  <h2 style="margin:0 0 8px;">🔔 Notification Management</h2>
  <p style="color:#888; font-size:13px; margin:0;">View notification history and manage push subscriptions.</p>
</div>

<!-- Quick Actions -->
<div style="display:flex; gap:12px; margin-bottom:20px; flex-wrap:wrap; align-items:center;">
  <button type="button" id="btnToggleCustomNotif" onclick="toggleCustomForm()" style="padding:9px 18px; border:none; border-radius:8px; background:linear-gradient(135deg, #ff9933 0%, #e65100 100%); color:#fff; font-weight:600; cursor:pointer; font-size:13.5px; display:inline-flex; align-items:center; gap:6px;">
    <span>📢</span> Send Custom Notification
  </button>
  <button type="button" onclick="sendTestNotification()" style="padding:9px 16px; border:1px solid #ddd; border-radius:8px; background:#fff; cursor:pointer; font-size:13px; color:#555;">
    🔔 Send Quick Test
  </button>
</div>

<!-- Custom Notification Form Card (Collapsible) -->
<div id="customNotifCard" style="display:none; background:#fff; border:1px solid #e9ecef; border-radius:12px; padding:20px 24px; margin-bottom:28px; box-shadow:0 2px 8px rgba(0,0,0,0.04); max-width:640px;">
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
    <h3 style="margin:0; font-size:16px; color:#333; display:flex; align-items:center; gap:8px;">
      <span>📢</span> New Custom Notification
    </h3>
    <button type="button" onclick="toggleCustomForm()" style="background:none; border:none; font-size:18px; color:#888; cursor:pointer;">✕</button>
  </div>

  <form id="customNotifForm" onsubmit="handleSendCustom(event)">
    <div style="margin-bottom:14px;">
      <label style="display:block; font-size:13px; font-weight:600; color:#444; margin-bottom:6px;">Notification Title *</label>
      <input type="text" id="custTitle" required maxlength="150" placeholder="e.g. Special Bhajan Practice at 6 PM"
        style="width:100%; padding:10px 12px; border:1px solid #ddd; border-radius:8px; font-size:14px; box-sizing:border-box;">
    </div>

    <div style="margin-bottom:14px;">
      <label style="display:block; font-size:13px; font-weight:600; color:#444; margin-bottom:6px;">Message / Body *</label>
      <textarea id="custBody" required rows="3" maxlength="500" placeholder="Enter message for devotees..."
        style="width:100%; padding:10px 12px; border:1px solid #ddd; border-radius:8px; font-size:14px; font-family:inherit; resize:vertical; box-sizing:border-box;"></textarea>
    </div>

    <div style="margin-bottom:14px;">
      <label style="display:block; font-size:13px; font-weight:600; color:#444; margin-bottom:6px;">Action Link (optional)</label>
      <input type="text" id="custLink" placeholder="e.g. /submit-form or /plan-view" value="/"
        style="width:100%; padding:10px 12px; border:1px solid #ddd; border-radius:8px; font-size:14px; box-sizing:border-box;">
    </div>

    <div style="margin-bottom:18px;">
      <label style="display:block; font-size:13px; font-weight:600; color:#444; margin-bottom:8px;">Target Audience</label>
      <div style="display:flex; gap:18px; align-items:center; margin-bottom:10px;">
        <label style="display:inline-flex; align-items:center; gap:6px; font-size:13.5px; cursor:pointer;">
          <input type="radio" name="custTarget" value="all" checked onchange="handleTargetChange()">
          <span>📢 All Devotees (Broadcast)</span>
        </label>
        <label style="display:inline-flex; align-items:center; gap:6px; font-size:13.5px; cursor:pointer;">
          <input type="radio" name="custTarget" value="singer" onchange="handleTargetChange()">
          <span>👤 Specific Singer</span>
        </label>
      </div>

      <div id="singerSelectWrap" style="display:none; margin-top:8px;">
        <select id="custSingerId" style="width:100%; padding:10px 12px; border:1px solid #ddd; border-radius:8px; font-size:14px; background:#fff; box-sizing:border-box;">
          <option value="">— Select a singer —</option>
          <% if (typeof allSingers !== 'undefined' && allSingers) { %>
            <% allSingers.forEach(function(s) { %>
              <option value="<%= s.id %>"><%= s.name %></option>
            <% }); %>
          <% } %>
        </select>
      </div>
    </div>

    <div style="display:flex; gap:10px;">
      <button type="submit" id="custSubmitBtn" style="padding:10px 22px; border:none; border-radius:8px; background:linear-gradient(135deg, #ff9933 0%, #e65100 100%); color:#fff; font-weight:600; font-size:14px; cursor:pointer;">
        Send Notification
      </button>
      <button type="button" onclick="toggleCustomForm()" style="padding:10px 18px; border:1px solid #ddd; border-radius:8px; background:#fff; color:#666; font-size:14px; cursor:pointer;">
        Cancel
      </button>
    </div>
  </form>
</div>

<!-- Subscriptions -->
<div style="margin-bottom:32px;">
  <h3 style="margin:0 0 12px; font-size:16px;">📱 Push Subscriptions (<%= subscriptions.length %>)</h3>
  <% if (subscriptions.length > 0) { %>
  <div style="overflow-x:auto;">
    <table class="admin-bulletin-table">
      <thead>
        <tr>
          <th>Singer</th>
          <th>Device ID</th>
          <th>Status</th>
          <th>Registered</th>
        </tr>
      </thead>
      <tbody>
        <% subscriptions.forEach(function(s) { %>
        <tr>
          <td><strong><%= singerMap[s.singer_id] || 'Unknown' %></strong></td>
          <td style="font-size:11px; color:#888; font-family:monospace;"><%= s.device_id.substring(0, 16) %>...</td>
          <td>
            <span class="admin-bulletin-status <%= s.enabled ? 'published' : 'draft' %>"><%= s.enabled ? 'Active' : 'Disabled' %></span>
          </td>
          <td style="font-size:12px; color:#888;">
            <%= new Date(s.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% } else { %>
  <p style="color:#999; font-size:14px;">No push subscriptions registered yet.</p>
  <% } %>
</div>

<!-- Notification History -->
<div>
  <h3 style="margin:0 0 12px; font-size:16px;">📋 Notification History (<%= notifications.length %>)</h3>
  <% if (notifications.length > 0) { %>
  <div style="overflow-x:auto;">
    <table class="admin-bulletin-table">
      <thead>
        <tr>
          <th>Type</th>
          <th>Title</th>
          <th>Event Key</th>
          <th>Created</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% notifications.forEach(function(n) { %>
        <tr>
          <td>
            <span class="admin-bulletin-status <%= n.type === 'test' ? 'draft' : 'published' %>" style="font-size:10px;"><%= n.type %></span>
          </td>
          <td>
            <strong><%= n.title %></strong>
            <div style="font-size:11px; color:#888; margin-top:2px;"><%= (n.body || '').substring(0, 80) %><%= n.body && n.body.length > 80 ? '...' : '' %></div>
          </td>
          <td style="font-size:10px; color:#aaa; font-family:monospace; max-width:200px; overflow:hidden; text-overflow:ellipsis;"><%= n.event_key %></td>
          <td style="font-size:12px; color:#888;">
            <%= new Date(n.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %>
          </td>
          <td>
            <div class="admin-bulletin-actions">
              <button onclick="deleteNotification(<%= n.id %>)" class="btn-delete">Delete</button>
            </div>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% } else { %>
  <p style="color:#999; font-size:14px;">No notifications generated yet.</p>
  <% } %>
</div>

<script>
function toggleCustomForm() {
  const card = document.getElementById('customNotifCard');
  if (card.style.display === 'none') {
    card.style.display = 'block';
    document.getElementById('custTitle').focus();
  } else {
    card.style.display = 'none';
  }
}

function handleTargetChange() {
  const isSinger = document.querySelector('input[name="custTarget"]:checked').value === 'singer';
  const wrap = document.getElementById('singerSelectWrap');
  wrap.style.display = isSinger ? 'block' : 'none';
  const select = document.getElementById('custSingerId');
  select.required = isSinger;
}

function handleSendCustom(e) {
  e.preventDefault();
  const btn = document.getElementById('custSubmitBtn');
  const title = document.getElementById('custTitle').value.trim();
  const body = document.getElementById('custBody').value.trim();
  const link = document.getElementById('custLink').value.trim();
  const targetType = document.querySelector('input[name="custTarget"]:checked').value;
  const singerId = document.getElementById('custSingerId').value;

  if (targetType === 'singer' && !singerId) {
    alert('Please select a singer.');
    return;
  }

  btn.disabled = true;
  btn.textContent = 'Sending...';

  fetch('/admin/notifications/send-custom', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      title: title,
      body: body,
      link: link || '/',
      target_type: targetType,
      singer_id: singerId || null
    })
  })
    .then(r => r.json())
    .then(data => {
      if (data.success) {
        alert(data.message || 'Custom notification sent!');
        location.reload();
      } else {
        alert('Failed: ' + (data.error || 'Unknown error'));
        btn.disabled = false;
        btn.textContent = 'Send Notification';
      }
    })
    .catch(err => {
      alert('Error: ' + err.message);
      btn.disabled = false;
      btn.textContent = 'Send Notification';
    });
}

function sendTestNotification() {
  fetch('/admin/notifications/test', { method: 'POST' })
    .then(r => r.json())
    .then(data => {
      if (data.success) {
        alert('Test notification sent!');
        location.reload();
      } else {
        alert('Failed: ' + (data.error || 'Unknown error'));
      }
    })
    .catch(err => alert('Error: ' + err.message));
}

function deleteNotification(id) {
  if (!confirm('Delete this notification?')) return;
  fetch(`/admin/notifications/${id}/delete`, { method: 'POST' })
    .then(r => r.json())
    .then(() => location.reload())
    .catch(err => alert('Error: ' + err.message));
}
</script>
