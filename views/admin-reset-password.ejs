<!DOCTYPE html>
<html>
<head>
    <title>Reset Password</title>
</head>
<body>

<h1>

Reset Password

</h1>

<p>

<%= admin.display_name %>

</p>

<% if(error){ %>

<p style="color:red">

<%= error %>

</p>

<% } %>

<form
method="POST"
action="/admin/admin-users/<%= admin.id %>/reset-password">

<p>

New Password

<br>

<input
type="password"
name="password"
required>

</p>

<button>

Reset Password

</button>

</form>

<p>

<a href="/admin/admin-users">

Back

</a>

</p>

</body>
</html>