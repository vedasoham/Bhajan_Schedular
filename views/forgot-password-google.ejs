<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Password Recovery</title>

    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel="stylesheet" href="/css/style.css">

    <style>

        .container{
            max-width:460px;
            padding:40px;
        }

        .subtitle{
            text-align:center;
            color:#666;
            margin-top:-8px;
            margin-bottom:28px;
            line-height:1.6;
        }

        .card{
            background:#f8f9fa;
            border-radius:12px;
            padding:22px;
            margin-bottom:28px;
            text-align:center;
        }

        .card h3{
            margin:0 0 12px;
            color:#C2185B;
        }

        .card p{
            margin:8px 0;
            color:#555;
        }

        #google-signin-button{
            display:flex;
            justify-content:center;
            margin-top:24px;
        }

        .google-login-error{
            min-height:20px;
            margin-top:18px;
            color:#c62828;
            text-align:center;
            font-size:14px;
        }

        .back-link{
            text-align:center;
            margin-top:26px;
        }

        .back-link a{
            color:#868e96;
            text-decoration:none;
        }

        .back-link a:hover{
            text-decoration:underline;
        }

    </style>

</head>

<body>

<div class="container">

    <h2
        style="
        text-align:center;
        color:#C2185B;
        margin-bottom:14px;">
        🔑 Password Recovery
    </h2>

    <p class="subtitle">

        Continue with your linked Google account
        to verify your identity.

    </p>

    <div class="card">

        <h3>

            Hello, <%= admin.display_name %>

        </h3>

        <p>

            Your administrator account has a
            Google account linked.

        </p>

        <p>

            Sign in below to continue resetting
            your password.

        </p>

    </div>

    <div id="google-signin-button"></div>

    <p
        id="google-login-error"
        class="google-login-error">
    </p>

    <div class="back-link">

        <a href="/forgot-password">

            ← Back

        </a>

    </div>

</div>

<script>

async function handleGoogleCredential(response){

    const errorElement =
        document.getElementById(
            "google-login-error"
        );

    errorElement.textContent = "";

    try{

        const result =
            await fetch(
                "/auth/google/recovery",
                {
                    method:"POST",
                    headers:{
                        "Content-Type":"application/json"
                    },
                    body:JSON.stringify({
                        credential:response.credential,
                        adminId:<%= admin.id %>
                    })
                }
            );

        const data =
            await result.json();

        if(!result.ok || !data.success){

            errorElement.textContent =
                data.error ||
                "Google verification failed.";

            return;

        }

        window.location.href =
            data.redirect;

    }

    catch(error){

        console.error(error);

        errorElement.textContent =
            "Google verification failed. Please try again.";

    }

}

window.addEventListener("load",()=>{

    google.accounts.id.initialize({

        client_id:
            <%- JSON.stringify(googleClientId) %>,

        callback:
            handleGoogleCredential,

        auto_select:false

    });

    google.accounts.id.renderButton(

        document.getElementById(
            "google-signin-button"
        ),

        {
            type:"standard",
            theme:"outline",
            size:"large",
            text:"continue_with",
            shape:"rectangular",
            width:320
        }

    );

});

</script>

<script
src="https://accounts.google.com/gsi/client"
async
defer>
</script>

</body>
</html>